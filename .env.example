# ==============================================================================
# LLM Provider Configuration
# Choose either Groq (Default / Recommended for ultra-fast inference) or OpenRouter
# ==============================================================================
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ==============================================================================
# Financial News API Configuration
# Free API key from https://newsapi.org/
# ==============================================================================
NEWS_API_KEY=your_news_api_key_here

# ==============================================================================
# SEC EDGAR Ingestion Configuration
# SEC EDGAR requires a User-Agent header in the format: Name email@domain.com
# ==============================================================================
USER_AGENT=YourName your_email@example.com
